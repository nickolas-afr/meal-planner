<div class="field">
    <label for="@_id">@Label</label>
    <input @ref="_input" id="@_id" type="text" value="@Value" placeholder="@Placeholder" inputmode="@InputMode"
           maxlength="@MaxLength" disabled="@Disabled" class="@(HasError ? "invalid" : null)"
           aria-invalid="@(HasError ? "true" : null)" aria-describedby="@(HasError ? _errorId : null)"
           autocomplete="off" @oninput="OnInput" @onchange="OnChange" @attributes="Attributes" />
    <FieldError Id="@_errorId" Message="@Error" />
</div>

@code {
    private readonly string _id = ElementIds.New("tf");
    private readonly string _errorId = ElementIds.New("tf-err");
    private ElementReference _input;

    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? InputMode { get; set; }
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool AutoFocus { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);

    public ValueTask FocusAsync() => _input.FocusAsync();

    // Value updates on every keystroke; onchange covers autofill and dictation that skip input events.
    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
    private Task OnChange(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AutoFocus) await _input.FocusAsync();
    }
}
