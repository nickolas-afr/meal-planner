<label class="toggle @(Disabled ? "disabled" : null)">
    <span class="text">
        <span class="label">@Label</span>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <span class="sub">@Subtitle</span>
        }
    </span>
    <input type="checkbox" role="switch" checked="@Value" disabled="@Disabled" @onchange="OnChange" />
    <span class="track" aria-hidden="true"><span class="knob"></span></span>
</label>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private Task OnChange(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value is true);
}
