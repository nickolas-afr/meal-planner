@using MealPlanner.App.Components.Icons

<div class="stepper @(Disabled ? "disabled" : null)">
    <button type="button" class="btn" aria-label="Remove one @Label" disabled="@Disabled" @onclick="OnDecrement"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M5 12h14" /></svg></button>
    <span class="value" aria-live="polite">@Value</span>
    <button type="button" class="btn" aria-label="Add one @Label" disabled="@Disabled" @onclick="OnIncrement"><PlusIcon Size="18" /></button>
</div>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback OnIncrement { get; set; }
    [Parameter] public EventCallback OnDecrement { get; set; }
    /// <summary>Names the meal in the button aria-labels.</summary>
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
}
