@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav

<NavGuard>
    <div class="shell">
        <div class="banner-stack">
            @* Banner stack: Offline / Update available / List out of date banners go here (stacked, under the safe area). *@
        </div>
        <main class="page @(ShowTabBar ? "with-tabbar" : null)">
            @Body
        </main>
        @if (ShowTabBar)
        {
            <TabBar />
        }
    </div>
</NavGuard>

@code {
    private bool ShowTabBar
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
            return path != "settings" && !path.StartsWith("meals/", StringComparison.Ordinal);
        }
    }

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
