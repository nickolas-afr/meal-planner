@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject UpdateService Updates

<NavGuard>
    <div class="shell">
        <div class="banner-stack @(HasBanners ? "has-banners" : null)">
            @* Banner stack: Offline / List out of date banners go here too (stacked, under the safe area). *@
            @if (Updates.UpdateAvailable)
            {
                <Banner Variant="BannerVariant.UpdateAvailable" Text="New version available" ActionText="Reload" OnAction="Updates.ReloadAsync" />
            }
        </div>
        <main class="page @(ShowTabBar ? "with-tabbar" : null)">
            @Body
        </main>
        @if (ShowTabBar)
        {
            <TabBar />
        }
    </div>
</NavGuard>

@code {
    private bool HasBanners => Updates.UpdateAvailable;

    private bool ShowTabBar
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
            return path != "settings" && !path.StartsWith("meals/", StringComparison.Ordinal);
        }
    }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Updates.OnChange += OnUpdatesChanged;
    }

    private void OnUpdatesChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Updates.OnChange -= OnUpdatesChanged;
    }
}
