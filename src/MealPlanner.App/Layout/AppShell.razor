@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject UpdateService Updates
@inject IServiceProvider Services

<NavGuard>
    <div class="shell">
        <div class="banner-stack @(HasBanners ? "has-banners" : null)">
            @if (ShowOffline)
            {
                <Banner Variant="BannerVariant.Offline" Text="Offline – changes will sync" />
            }
            @if (Updates.UpdateAvailable)
            {
                <Banner Variant="BannerVariant.UpdateAvailable" Text="New version available" ActionText="Reload" OnAction="Updates.ReloadAsync" />
            }
        </div>
        <main class="page @(ShowTabBar ? "with-tabbar" : null)">
            @Body
        </main>
        @if (ShowTabBar)
        {
            <TabBar />
        }
    </div>
</NavGuard>

@code {
    private SyncService? _sync;

    private bool ShowOffline => _sync?.ShowOfflineBanner ?? false;

    private bool HasBanners => Updates.UpdateAvailable || ShowOffline;

    private bool ShowTabBar
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
            return path is not ("settings" or "welcome" or "create" or "join") && !path.StartsWith("meals/", StringComparison.Ordinal);
        }
    }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Updates.OnChange += OnUpdatesChanged;
        _sync = Services.GetService<SyncService>();
        if (_sync is not null) _sync.OnChange += OnUpdatesChanged;
    }

    private void OnUpdatesChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Updates.OnChange -= OnUpdatesChanged;
        if (_sync is not null) _sync.OnChange -= OnUpdatesChanged;
    }
}
