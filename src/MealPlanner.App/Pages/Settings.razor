@page "/settings"
@implements IAsyncDisposable
@inject AppState State
@inject MarketService MarketSvc
@inject IJSRuntime JS
@inject BackupService Backup
@inject PreferencesService Prefs
@inject UpdateService Updates
@using System.Globalization

<PageTitle>Settings</PageTitle>
<NavHeader BackHref="/meals" BackLabel="Meals" Title="Settings" />

<div class="content">
    @* M5 adds the Household section above Markets and the Account section after App. *@
    <section>
        <h2 class="t-section-label">Markets</h2>
        <div class="card">
            @* Sortable owns the DOM of this element's children, so @key changes after each reorder to rebuild it. *@
            <div class="list" @ref="_list" @key="_listKey">
                @foreach (var m in _markets)
                {
                    <div class="mrow" data-id="@m.Id" @key="m.Id">
                        <button type="button" class="mname" @onclick="() => OpenEdit(m)">@m.Name</button>
                        <span class="drag-handle" aria-label="Reorder @m.Name" role="img"><DragHandleIcon Size="22" /></span>
                    </div>
                }
            </div>
            <form class="add" @onsubmit="AddAsync">
                <div class="addfield">
                    <input type="text" aria-label="Add a market" placeholder="Add a market" maxlength="40"
                           autocomplete="off" value="@_newName" @oninput="OnNewInput"
                           aria-invalid="@(AddError is null ? null : "true")" aria-describedby="@(AddError is null ? null : "add-err")" />
                    <button type="submit" class="addbtn" disabled="@(NewInvalid)">Add</button>
                </div>
                <FieldError Id="add-err" Message="@AddError" />
            </form>
        </div>
        <p class="note t-secondary">@(_markets.Count == 0
            ? "No markets yet. Everything goes under Anywhere."
            : "Order them the way you shop. Items are grouped by these on the shopping list.")</p>
    </section>

    <section>
        <h2 class="t-section-label">Backup</h2>
        <div class="card">
            <button type="button" class="arow" @onclick="ExportAsync">
                <span class="tile"><DownloadIcon Size="20" /></span>
                <span class="atext"><span class="atitle">Export data</span><span class="asub t-secondary">Saves everything as a .json file</span></span>
            </button>
            <label class="arow import">
                <span class="tile"><UploadIcon Size="20" /></span>
                <span class="atext"><span class="atitle">Import data</span><span class="asub t-secondary">Replaces everything for both of you</span></span>
                <InputFile @key="_fileInputKey" class="visually-hidden" accept=".json,application/json" OnChange="OnFileChosen" />
            </label>
        </div>
        <FieldError Id="import-err" Message="@_importError" />
        @if (_imported)
        {
            <p class="note t-secondary" role="status">Imported.</p>
        }
        <p class="note t-secondary">@LastExportText</p>
    </section>

    <section>
        <h2 class="t-section-label">App</h2>
        <div class="card">
            <div class="arow static">
                <span class="atext"><span class="atitle">Version</span></span>
                <span class="aval">@Updates.Version</span>
            </div>
            <button type="button" class="arow" disabled="@_checking" @onclick="CheckAsync">
                <span class="atext"><span class="atitle">Check for updates</span>
                    @if (_upToDate)
                    {
                        <span class="asub t-secondary" role="status">You're up to date</span>
                    }
                </span>
            </button>
        </div>
    </section>
</div>

<ConfirmDialog Open="_preview is not null" Title="Import data?" Message="@ImportMessage" ConfirmText="Import" Destructive="true"
               OnConfirm="ImportAsync" OnCancel="@(() => _preview = null)" />

<BottomSheet Open="_editing is not null && !_confirmDelete" Title="Market" ConfirmText="Save"
             ConfirmDisabled="@(EditError is not null || string.IsNullOrWhiteSpace(_editName))"
             OnConfirm="SaveEditAsync" OnCancel="CloseEdit">
    <div class="sheet-form">
        <TextField @bind-Value="_editName" Label="Name" MaxLength="40" Error="@EditError" AutoFocus="true" />
        <PrimaryButton Variant="ButtonVariant.Danger" OnClick="@(() => _confirmDelete = true)">Delete market</PrimaryButton>
    </div>
</BottomSheet>

<ConfirmDialog Open="_confirmDelete" Title="@($"Delete {_editing?.Name}?")"
               Message="@($"Items from {_editing?.Name} will move to Anywhere.")" ConfirmText="Delete" Destructive="true"
               OnConfirm="DeleteAsync" OnCancel="@(() => _confirmDelete = false)" />

@code {
    private BackupPreview? _preview;
    private string? _importError;
    private bool _imported;
    private int _fileInputKey; // bumped after each pick so choosing the same file again fires a change
    private bool _checking;
    private bool _upToDate;
    private int _checkSeq;

    private string LastExportText => Prefs.LastExportAt is { } t
        ? "Last export: " + t.ToLocalTime().ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
        : "Last export: never";

    private string? ImportMessage => _preview is null ? null
        : $"Import {Count(_preview.Meals, "meal", "meals")}, {Count(_preview.Ingredients, "ingredient", "ingredients")}, {Count(_preview.Markets, "market", "markets")}? This replaces everything for both of you.";

    private static string Count(int n, string one, string many) => $"{n} {(n == 1 ? one : many)}";

    private async Task ExportAsync()
    {
        _imported = false;
        await Backup.ExportAsync();
        StateHasChanged();
    }

    private async Task OnFileChosen(InputFileChangeEventArgs e)
    {
        _importError = null;
        _imported = false;
        _preview = null;
        try
        {
            using var stream = e.File.OpenReadStream(5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            _preview = Backup.Preview(await reader.ReadToEndAsync());
        }
        catch (IOException) { }
        if (_preview is null) _importError = "That file isn't a Meal Planner backup.";
        _fileInputKey++;
    }

    private async Task ImportAsync()
    {
        var p = _preview;
        _preview = null;
        if (p is null) return;
        await Backup.ImportAsync(p.File);
        _imported = true;
    }

    private async Task CheckAsync()
    {
        _checking = true;
        _upToDate = false;
        var seq = ++_checkSeq;
        try
        {
            var available = await Updates.CheckForUpdatesAsync();
            if (!available)
            {
                _upToDate = true;
                _ = HideUpToDateAsync(seq);
            }
        }
        finally { _checking = false; }
    }

    private async Task HideUpToDateAsync(int seq)
    {
        await Task.Delay(4000);
        if (_disposed || seq != _checkSeq) return;
        _upToDate = false;
        await InvokeAsync(StateHasChanged);
    }

    private ElementReference _list;
    private Guid _listKey = Guid.NewGuid();
    private DotNetObjectReference<Settings>? _self;
    private int _sortableId;
    private bool _needsInit = true;
    private bool _disposed;

    private string _newName = "";
    private Market? _editing;
    private string _editName = "";
    private bool _confirmDelete;

    private IReadOnlyList<Market> _markets => MarketSvc.All();

    private string? AddError => string.IsNullOrWhiteSpace(_newName) ? null : MarketSvc.ValidateName(_newName, null);
    private bool NewInvalid => string.IsNullOrWhiteSpace(_newName) || AddError is not null;
    private string? EditError => _editing is null ? null : MarketSvc.ValidateName(_editName, _editing.Id);

    protected override void OnInitialized()
    {
        _self = DotNetObjectReference.Create(this);
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private void OnNewInput(ChangeEventArgs e) => _newName = e.Value?.ToString() ?? "";

    private async Task AddAsync()
    {
        if (NewInvalid) return;
        await MarketSvc.Add(_newName);
        _newName = "";
    }

    private void OpenEdit(Market m)
    {
        _editing = m;
        _editName = m.Name;
        _confirmDelete = false;
    }

    private void CloseEdit()
    {
        _editing = null;
        _confirmDelete = false;
    }

    private async Task SaveEditAsync()
    {
        if (_editing is null || EditError is not null) return;
        await MarketSvc.Rename(_editing.Id, _editName);
        CloseEdit();
    }

    private async Task DeleteAsync()
    {
        if (_editing is { } m) await MarketSvc.Delete(m.Id);
        CloseEdit();
    }

    [JSInvokable]
    public async Task OnReorder(string[] ids)
    {
        var parsed = ids.Select(s => Guid.TryParse(s, out var g) ? g : (Guid?)null)
            .Where(g => g is not null).Select(g => g!.Value).ToList();
        await MarketSvc.Reorder(parsed);
        // Sortable moved DOM nodes Blazor owns: rebuild the list element from scratch and re-init on that render.
        await DestroySortableAsync();
        _listKey = Guid.NewGuid();
        _needsInit = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_needsInit || _disposed) return;
        _needsInit = false;
        await DestroySortableAsync();
        _sortableId = await JS.InvokeAsync<int>("mealPlanner.sortable.init", _list, _self, ".drag-handle");
    }

    private async Task DestroySortableAsync()
    {
        if (_sortableId == 0) return;
        var id = _sortableId;
        _sortableId = 0;
        try { await JS.InvokeVoidAsync("mealPlanner.sortable.destroy", id); } catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        State.OnChange -= OnStateChanged;
        await DestroySortableAsync();
        _self?.Dispose();
    }
}
